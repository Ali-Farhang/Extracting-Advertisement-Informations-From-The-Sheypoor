def save_to_db(data, f_value):
    connection = connect_db()
    if connection:
        cursor = connection.cursor()
        existing_hashes = set()  # An array to store existing hashes

        # Load existing hashes from database
        cursor.execute("SELECT hash_value FROM Advertisements")
        for row in cursor.fetchall():
            existing_hashes.add(row[0])

        insert_data = []  
        try:
            # Checking the presence of f_value in the database
            cursor.execute("SELECT f_value FROM MetaValues ORDER BY created_at DESC")
            last_f_value = cursor.fetchone()
            last_f_value = last_f_value[0] if last_f_value else None

            if f_value != last_f_value:  # If the new f_value is different from the previous one
                # Save the new f_value
                cursor.execute("INSERT INTO MetaValues (f_value) VALUES (?)", (f_value,))
                connection.commit()  # Apply changes

            for ad in data:
                hash_value = generate_hash(ad)  # Hash generation
                
                # Checking if the new ad hash already exists
                if hash_value not in existing_hashes:
                    specifications = json.dumps(ad["specifications"], ensure_ascii=False)

                    # Add data to the list
                    insert_data.append((
                        ad["id"],  # Using Ad_Key is the same as id
                        ad["title"], 
                        ad["url"],
                        ad["description"], 
                        ad.get("phone_number", "نامشخص"), 
                        specifications, 
                        hash_value, 
                        ad["status"]
                    ))
                    existing_hashes.add(hash_value)  # Add a new hash to the collection

                    # Send to API and store Ad_Key
                    send_to_api(ad, f_value, connection)

            # If the list of data is not empty, we insert them in bulk
            if insert_data:
                cursor.executemany("""
                    INSERT INTO Advertisements (Ad_Key, Title, Link, Description, Phone_Number, Specifications, hash_value, status)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """, insert_data)

                # After entering all the data, we apply the changes
                connection.commit()
                logging.info(f"Inserted {len(insert_data)} new records into the database.")
            else:
                logging.info("No new data to insert.")

        except pyodbc.Error as e:
            logging.error(f"Failed to insert data into DB: {e}")
            connection.rollback()  # In case of error, we revert the changes
        finally:
            cursor.close()
