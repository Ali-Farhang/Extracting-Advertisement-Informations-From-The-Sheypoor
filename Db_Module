def generate_hash(ad):
    hash_input = f"{ad['id']}{ad['title']}{ad['url']}{ad['description']}{ad['specifications']}{ad.get('phone_number', '')}"
    hash_value = hashlib.sha256(hash_input.encode('utf-8')).hexdigest()
    logging.info(f"Generated hash for ad {ad['id']}: {hash_value}")
    return hash_value

