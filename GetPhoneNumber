def fetch_phone_number(ad_key, captcha_token=None, captcha_code=None):
    """
    Get the contact number of the ad (with captcha support)
    """
    header = {
        "User-Agent": "",
        "Content-Type": "",
        "Cookie": ""
}
    
    if captcha_token and captcha_code:
        header["X-Captcha-Token"] = captcha_token
        header["X-Captcha-Code"] = captcha_code

    url = f""
    try:
        response = requests.get(url, headers=header)
        response.raise_for_status()
        data = response.json()
        if "data" in data and "attributes" in data["data"]:
            phone_number = data["data"]["attributes"].get("phoneNumber", "نامشخص")
            return phone_number, 0  # State 1: Complete information extracted
        return "نامشخص", 0  # Status 0: Error in phone number extraction
    except requests.RequestException as e:
        if response.status_code == 429:  # Need to solve captcha
            try:
                error_data = response.json().get("errors", [{}])[0]
                captcha_meta = error_data.get("meta", {})
                token = captcha_meta.get("token")
                captcha_image_base64 = captcha_meta.get("image")
                if captcha_image_base64:
                    save_captcha_image(captcha_image_base64)
                    logging.error("Captcha detected. Please solve the captcha.")
                    
                    # Solving captcha using solver.py
                    user_input = solve_captcha(captcha_image_base64)  # It is assumed that an image is taken as input
                    phone_number, _ = fetch_phone_number(ad_key, token, user_input)
                    return phone_number, 1  # State 1: Complete information extracted
            except Exception as captcha_error:
                logging.error(f"Error processing captcha: {captcha_error}")
                return  "نامشخص", 0
        else:
            logging.error(f"Error fetching phone number for ad {ad_key}: {e}")
        return "نامشخص", 0  #Status 0: Error in phone number extraction
    
def save_captcha_image(base64_string, filename="captcha_image.jpg"):

    try:
        image_data = base64.b64decode(base64_string)
        with open(filename, "wb") as file:
            file.write(image_data)
        logging.info(f"Captcha image saved as {filename}.")
    except Exception as e:
        logging.error(f"Error saving captcha image: {e}")

